<IfModule mod_mime.c>
  AddType application/javascript .mjs
</IfModule>

<FilesMatch "\\.mjs$">
  ForceType application/javascript
</FilesMatch>

# Keep client-side routes working when a visitor opens them directly.
# The React app handles the route after index.html is loaded.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
